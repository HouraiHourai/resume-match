# DeepSeek API key (主模型: DeepSeek V4 Flash)
# 获取地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 通义千问 API key (备用模型: Qwen 3.8 Max)
# 获取地址: https://dashscope.aliyun.com
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# SiliconFlow BGE-M3 embeddings (https://siliconflow.cn)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 进程内Embedding缓存：0关闭；修改后重启服务。不会缓存检索结果。
EMBEDDING_CACHE_MAX_ENTRIES=256
EMBEDDING_CACHE_TTL_SECONDS=3600

# (可选) 默认模型选择，默认为 deepseek
# DEFAULT_MODEL=deepseek

# (可选) LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=resume_match
